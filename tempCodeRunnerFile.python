class Vehicle:
    def __init__(self, name, max_speed):
        print(type(self))
        self.name = name
        self.max_speed = max_speed

    def display(self):
        print(f'Vehicle Name: {self.name}, Max Speed: {self.max_speed} km/h')

car = Vehicle('Toyota', 180)
car.display()

